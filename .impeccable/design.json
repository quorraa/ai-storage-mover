      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The current forward action; colors inherit the active light or dark CSS variables.",
      "html": "<button class=\"ds-btn-primary\">Continue <svg class=\"ds-primary-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{font-family:Inter,sans-serif;font-size:14px;line-height:1.5;font-weight:550;border:1px solid transparent;border-radius:8px;background:var(--accent, #5357d8);color:var(--accent-ink, #fff);min-height:40px;padding:9px 15px;display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;transition:background-color .12s ease-out}.ds-btn-primary:hover:not(:disabled){background:var(--accent, #5357d8);filter:brightness(1.07);}.ds-btn-primary:focus-visible{outline:2px solid var(--focus, #5357d8);outline-offset:3px}.ds-btn-primary:disabled{cursor:default;opacity:.45}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}.ds-primary-icon{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}"
