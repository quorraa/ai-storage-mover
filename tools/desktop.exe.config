<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Trust the managed dependencies of this portable app when Windows
         retains Internet-zone metadata on files extracted from a download.
         This is process-scoped; it does not remove download flags or alter
         Windows/.NET policy for other applications. -->
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
